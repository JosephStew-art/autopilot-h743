		(uuid "e1e2b168-e742-5793-b454-4603a95a0b58")
	)
	(text "Custom ArduPilot hwdef and bootloader required.\n8MHz HSE; reserve 128KB boot and internal parameter sectors.\nUse revision-appropriate CPU clock; 480MHz is not assumed.\nNC markers identify every intentionally unused package pin."
