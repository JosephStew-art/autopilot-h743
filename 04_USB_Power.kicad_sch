	(text "USB BENCH POWER | 5 V TYPE-C SOURCE ADVERTISING 1.5 A OR 3 A"
		(exclude_from_sim no)
		(at 20 18 0)
		(effects
			(font
				(size 2.2 2.2)
			)
			(justify left top)
		)
		(uuid "664058b3-9f1b-550c-be1d-7301d6f1a5fa")
	)
	(text "OUT1 LOW permits bench power; PNP + EN pulldown keep switch disabled while CC rail is absent.\nTUSB320LI provides both Rd terminations. ADDR intentionally floating selects GPIO mode; no extra CC resistors.\n20k ILIM: 1.295A typical, 1.375A maximum before resistor tolerance; below the 1.5A advertised source budget.\nController latches initial current advertisement: use a stable-current source; replug after source/power-mode changes.\nDefault-current USB-A sources provide data with MAIN 5V connected. Servo / external 5V loads are not USB powered."
		(exclude_from_sim no)
		(at 20 250 0)
		(effects
			(font
				(size 1.2 1.2)
			)
			(justify left top)
		)
		(uuid "e24a2d42-c132-5c05-8ed5-fda07564b9fa")
	)
