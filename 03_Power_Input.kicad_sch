	(text "TPS2113A: IN1 selected above nominal 4.13V; otherwise selects the higher valid input. EN is active LOW.\nR_ILIM=470 ohm sets ~1.06A nominal system limit; allow tolerance and thermal margin.\nSTAT LOW = MAIN selected (or disabled); HIGH = USB selected. The MCU cannot infer voltage from STAT.\nMux provides input isolation. Place local input/output bypass close; verify switchover under load."
		(exclude_from_sim no)
		(at 20 192 0)
		(effects
			(font
				(size 1.25 1.25)
			)
			(justify left top)
		)
		(uuid "823703a6-4e91-5e89-b103-c1a9f421d2fb")
	)
	(text "POWER-MODULE 5 V INPUT | USB / MAIN SOURCE SELECTION"
		(exclude_from_sim no)
		(at 20 18 0)
		(effects
			(font
				(size 2.5 2.5)
			)
			(justify left top)
		)
		(uuid "84e4e476-288f-5bad-b749-27d7011da948")
	)
	(text "External BEC / power module: regulated 4.75-5.25V only. Never connect raw battery to the flight controller.\nUse both 5V and both GND contacts. Fuse + reverse PMOS protect this 5V interface; not the raw battery bus.\nServo power is a separate BEC rail; common ground only. USB must never energize that rail."
		(exclude_from_sim no)
		(at 20 90 0)
		(effects
			(font
				(size 1.35 1.35)
			)
			(justify left top)
		)
		(uuid "d3e22c29-b5a8-57ca-94a0-1a5e70bbae2d")
	)
	(text "Power flags declare physical sources through\nconnectors / passive protection. They are ERC\nannotations, not additional circuit components."
		(exclude_from_sim no)
		(at 230 238 0)
		(effects
			(font
				(size 1.2 1.2)
			)
			(justify left top)
		)
		(uuid "f59295a6-733f-58a7-9b07-d58c744fb7f6")
	)
