	(text "ONBOARD I2C2 | MMC5983MA + SPA06-003"
		(exclude_from_sim no)
		(at 20 18 0)
		(effects
			(font
				(size 2.5 2.5)
			)
			(justify left top)
		)
		(uuid "5c043dee-1b04-5974-b440-8ba5c6677623")
	)
	(text "MMC5983MA: address 0x30; CS tied HIGH. CAP requires >=10uF effective low-ESR capacitance.\nSelected 22uF/25V capacitor adds derating margin; verify minimum effective capacitance across temperature and bias.\nSPA06-003: address 0x76 with SDO LOW; CSB HIGH selects I2C. ArduPilot AP_Baro_SPL06 recognizes chip ID 0x11.\nStart I2C at 100kHz; check rise times before increasing speed. One pullup pair on this onboard bus.\nKeep compass away from current loops / ferrous parts. Keep barometer vent open, shielded from propwash and light."
		(exclude_from_sim no)
		(at 20 244 0)
		(effects
			(font
				(size 1.22 1.22)
			)
			(justify left top)
		)
		(uuid "da808efa-e316-5e21-9d5d-3086b2577d5f")
	)
