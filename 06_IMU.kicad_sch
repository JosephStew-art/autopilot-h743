	(text "SPI mode: PS pin7 GND. Shared SCK/SDI/SDO; separate chip selects with reset-state pullups.\nAccel INT1 pin16 -> PC13; gyro INT3 pin12 -> PE2. INT2 pin1 and INT4 pin13 are unused.\nPlace 100nF at each supply pin (3 and 11); keep SPI local. SPI clocks must obey the Bosch timing limits.\nFirmware uses separate accel and gyro SPI devices; confirm dummy-byte/startup sequence and sensor rotation.\nPlace near mechanical center, away from inductors and mounting stress; orientation is set after PCB placement."
		(exclude_from_sim no)
		(at 20 243 0)
		(effects
			(font
				(size 1.25 1.25)
			)
			(justify left top)
		)
		(uuid "2a7ada53-bea8-5daa-b7bc-942b51b173e3")
	)
	(text "BMI088 | SPI1 | ACCELEROMETER AND GYROSCOPE"
		(exclude_from_sim no)
		(at 20 18 0)
		(effects
			(font
				(size 2.5 2.5)
			)
			(justify left top)
		)
		(uuid "5511d836-887a-5d86-a2cb-e67a45878be5")
	)
	(text "TPS7A2033: quiet 3.3V sensor rail.\nBudget <100mA for all fitted sensors.\nMinimum effective Cout 1uF after derating.\nKeep sensor IO high-Z until supplies settle."
		(exclude_from_sim no)
		(at 276 40 0)
		(effects
			(font
				(size 1.25 1.25)
			)
			(justify left top)
		)
		(uuid "594df26c-5448-500a-863c-9ce1d5ec9379")
	)
