		(uuid "3eea1b94-e14a-5ecc-8ce9-9c6d760a0711")
	)
	(text "External I2C pin1: 3.3V / 50mA budget, including USB bench use. Check aggregate pullups and cable capacitance.\nExternal monitor: conditioned 0-3.3V voltage/current outputs, common GND. Never connect raw battery here.\nADC filters: 1k / 100nF. Calibrate to the chosen monitor; VOLT_MULT=16 / AMP_PERVLT=40 only for the separate reference module.\nNo I2C hot-plug or connector overvoltage guarantee. External loads must share GND and stay within the stated rails."
		(exclude_from_sim no)
		(at 20 250 0)
		(effects
			(font
				(size 1.25 1.25)
			)
			(justify left top)
		)
		(uuid "85cc2676-6980-58ba-ad8a-61b9f6e79eff")
	)
